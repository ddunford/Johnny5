# ─────────────────────────────────────────────────────────────
#  Johnny 5 — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
#  This file contains NO secrets — variable names + safe defaults only.
# ─────────────────────────────────────────────────────────────

# ── Local inference (inference.lan) — not secret, LAN-only ──
VISION_BASE_URL=http://inference.lan:8000
VISION_MODEL=qwen3.5:9b
VISION_TIMEOUT=120
LOCAL_LLM_REPLICA_URL=http://inference.lan:8001
TEI_BASE_URL=http://inference.lan:8002
TEI_MODEL=BAAI/bge-m3
TEI_DIMENSIONS=1024
YOLO_BASE_URL=http://inference.lan:8003

# ── Groq (cloud, heavy reasoning) — SECRET, leave blank here ──
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_BUDGET_USD=5.00          # crossing this trips "tired" → local-only

# ── Datastores — set strong values in .env, never here ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=johnny5
POSTGRES_USER=johnny5
POSTGRES_PASSWORD=                  # SECRET
DATABASE_URL=                       # SECRET (postgresql+asyncpg://...)
REDIS_URL=redis://redis:6379/0

# ── Cognitive cycle tuning ──
CYCLE_BASE_INTERVAL_SECONDS=4
SLEEP_MODE=energy_driven            # energy_driven | nightly_cron

# ── Interfaces ──
PUBLIC_DOMAIN=johnny.demosrv.uk
TRAEFIK_NETWORK=traefik_demosrv
WEB_PORT=80

# ── Voice (optional, Phase 7) ──
STT_MODEL=faster-whisper-base
TTS_VOICE=en_GB-alan-medium
WAKE_WORD=johnny

# ── Outbound messaging (optional, Phase 8) — all SECRET, blank here ──
SLACK_BOT_TOKEN=
PUSH_WEBHOOK_URL=

# ── Self-modification integrity gate (Core) ──
SELF_EDIT_APPROVER=dan              # who can approve tier-3 self-code edits
KILL_SWITCH_TOKEN=                  # SECRET — out-of-band hard stop
