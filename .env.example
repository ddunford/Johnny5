# ─────────────────────────────────────────────────────────────
#  Johnny 5 — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
#  This file contains NO secrets — variable names + safe defaults only.
#  Substrate values verified against inference.lan on 2026-05-26.
# ─────────────────────────────────────────────────────────────

# ── Runtime & observability ──
APP_ENV=development                          # development | production | testing
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
SERVICE_NAME=johnny5
SENTRY_DSN=                                   # SECRET — blank disables error tracking

# ── Local inference (inference.lan — Ollama on 2× RTX 3060, both GPUs) ──
LOCAL_LLM_BASE_URL=http://inference.lan:8000
# Fast, frequent cognition + image percepts. Multimodal + tool-calling. Resident on GPU.
LOCAL_FAST_MODEL=gemma4:e4b
# Heavier local reasoning + 128k context. Loaded on-demand (won't stay pinned alongside gemma4).
# NOTE: this tag is a "thinking" model — returns empty `content` with reasoning in a separate
# channel; the adapter must handle that (see brain/llm/providers/ollama.py).
LOCAL_REASONING_MODEL=qwen3.5-9b-128k:latest
LOCAL_LLM_TIMEOUT=120               # per-tick FAST model (gemma4) — kept tight for snappy hot-path failover
LOCAL_REASONING_TIMEOUT=240         # qwen reasoning model ONLY (heavy/offline roles) — its ~150s preamble+JSON needs the headroom; never applied to the per-tick fast model
# No :8001 replica — that service is down; single Ollama instance serves both GPUs.

# ── Embeddings (inference.lan:8002 — custom server, NOT TEI's native contract) ──
EMBED_BASE_URL=http://inference.lan:8002
EMBED_ENDPOINT=/embed             # POST {"inputs":"..."} -> {"embeddings":[[ ...1024 floats... ]]}
EMBED_MODEL=bge-m3
EMBED_DIMENSIONS=1024

# ── Vision / detection ──
# Captioning / VQA: use LOCAL_FAST_MODEL (gemma4:e4b) via LOCAL_LLM_BASE_URL (multimodal, verified).
YOLO_BASE_URL=http://inference.lan:8003      # object detection
OMNIPARSER_URL=http://inference.lan:8006     # UI/screen parsing (optional)
OCR_URL=http://inference.lan:8004            # OCR (optional)

# ── Groq (cloud, heavy reasoning) — SECRET, leave blank here ──
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile           # verified available
GROQ_DAILY_BUDGET_USD=5.00                   # crossing this trips "tired" → local-only

# ── LLM router tuning ──
LLM_ROUTES_PATH=config/llm_routes.toml       # per-role provider chain (versioned defaults)
CIRCUIT_FAILURE_THRESHOLD=4                   # consecutive provider fails before the circuit opens
CIRCUIT_RESET_SECONDS=60                      # how long a provider's circuit stays open before a trial
LLM_SCHEMA_RETRIES=1                          # retries-with-feedback on schema-validation failure

# ── Datastores — set strong values in .env, never here ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=johnny5
POSTGRES_USER=johnny5
POSTGRES_PASSWORD=                  # SECRET
DATABASE_URL=                       # SECRET (postgresql+asyncpg://...)
REDIS_URL=redis://redis:6379/0

# ── Cognitive cycle tuning ──
CYCLE_AUTOSTART=true                 # false = frozen maintenance/observation mode: bus+control+API+WS run but the heartbeat never ticks (deterministic empty state for the fresh-load smoke + demos)
CYCLE_BASE_INTERVAL_SECONDS=4

# ── Sleep / growth (Phase 4) — offline consolidation, decay, self-model, backups ──
SLEEP_EVERY_TICKS=0                 # force a sleep every N ticks (0 = off; Energy crossing its threshold is the real trigger)
CONSOLIDATION_MAX_CLUSTERS=8        # HARD CAP on consolidation LLM calls per sleep (cost guard while the cloud roles are live; Phase 6 adds the BudgetGovernor hard gate)
CONSOLIDATION_CLUSTER_THRESHOLD=0.6 # cosine ≥ this groups two episodes into one consolidation cluster
CONSOLIDATION_MAX_TOKENS=4096       # qwen-fallback reasoning-preamble headroom (1024 truncated on the local fallback; Groq primary unaffected)
DECAY_SALIENCE_HALFLIFE_SECONDS=604800   # an uncharged episode this old keeps half its above-floor salience (7d)
DECAY_SALIENCE_FLOOR=0.05           # episodic salience decays toward this, NEVER below — episodes are never hard-deleted
DECAY_CHARGED_BOOST=0.25            # emotion/goal-relevant episodes are strengthened this fraction toward 1.0
SEMANTIC_MERGE_THRESHOLD=0.95       # cosine ≥ this merges two near-duplicate semantic facts into one
SELF_MODEL_MAX_TOKENS=4096          # qwen-fallback reasoning-preamble + JSON headroom (1536 truncated on the local fallback)
METACOGNITION_MAX_TOKENS=4096       # qwen-fallback reasoning-preamble headroom (1536 truncated on the local fallback)

# ── Interfaces ──
PUBLIC_DOMAIN=johnny.demosrv.uk
TRAEFIK_NETWORK=traefik_demosrv
WEB_PORT=80
WS_TOKEN=                           # SECRET — interim gate on /ws/consciousness + cycle control (blank = open, dev only; Phase 5 replaces with session auth)

# ── Voice (Phase 7) — services already running on inference.lan ──
STT_BASE_URL=http://inference.lan:8890       # Speaches (whisper) STT
STT_MODEL=Systran/faster-whisper-small       # verified working; large-v3-turbo cache is corrupted
TTS_BASE_URL=http://inference.lan:8880       # Kokoro TTS
TTS_VOICE=af_sky                             # Kokoro voice id
WAKE_WORD=johnny

# ── Web exploration (Phase 6) — self-hosted, no API key ──
SEARXNG_URL=http://inference.lan:8889        # web/news search
# web_fetch SSRF/cost caps (Core-style — a tool's args can't loosen these).
WEB_FETCH_MAX_REDIRECTS=5                     # redirect hops, each re-validated post-DNS
WEB_FETCH_TIMEOUT_SECONDS=10                  # per-request wall-clock budget
WEB_FETCH_MAX_BYTES=2000000                   # hard cap on raw bytes downloaded
WEB_FETCH_MAX_TEXT_CHARS=20000                # cap on extracted text into the workspace

# ── Optional alt vector store ──
QDRANT_URL=http://inference.lan:6333

# ── Outbound messaging (Phase 8) — all SECRET, blank here ──
SLACK_BOT_TOKEN=
PUSH_WEBHOOK_URL=

# ── Self-modification integrity gate (Core) ──
SELF_EDIT_APPROVER=dan              # who can approve tier-3 self-code edits
KILL_SWITCH_TOKEN=                  # SECRET — out-of-band hard stop
